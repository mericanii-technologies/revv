+// Same as unpack_ksigns but without the byte broadcast: the 8 sign bits stay packed
+// in the low byte, which is what signs_ones_4 wants.
+static __device__ __forceinline__ uint32_t ksigns8(const uint8_t v) {
+    const uint32_t p = __popc(v) & 1;
+    return v ^ p << 7;
+}
+
+// Spread the low 4 bits of `bits` one per byte: byte k of the result is 0x01 if bit k
+// of `bits` is set and 0x00 otherwise.
+//
+// 0x00204081 == 2^21 + 2^14 + 2^7 + 1, so bit j of the input appears at bit j + 7k for
+// k = 0..3, i.e. in the disjoint ranges 0..3, 7..10, 14..17 and 21..24. Nothing overlaps,
+// so the multiply cannot carry, and masking with 0x01010101 keeps exactly bit k of the
+// input at bit 8k. Three instructions: LOP3 + IMAD + LOP3.
+//
+// This replaces "unpack_ksigns() & selector" followed by __vcmpne4, which costs six,
+// because sm_75 and later have no SIMD video instructions and nvcc emulates __vcmpne4
+// as LOP3 + IADD3 + LOP3 + PRMT.
+//
+// Note: __byte_perm() cannot be used to build the 0xff mask directly. Its selector
+// nibbles are masked to 3 bits, so the prmt sign-replicate mode (nibble msb set) is not
+// reachable through the intrinsic -- nvcc silently folds 0xba98 to the identity 0x3210.
+static __device__ __forceinline__ uint32_t signs_ones_4(const uint32_t bits) {
+    return ((bits & 0x0f) * 0x00204081) & 0x01010101;
+}
+
+// Negate byte k of v where byte k of `ones` is 0x01, leave it alone where it is 0x00.
+//
+// ones * 0xff turns each selected byte into 0xff and cannot carry because every byte of
+// `ones` is 0 or 1. Then -x == (x ^ 0xff) + 1 per byte; the +1 is only added where the
+// byte is selected, and it can only carry out of its byte if (v ^ 0xff) == 0xff there,
+// i.e. if that byte of v is zero. No byte of any i-quant codebook is ever zero
+// (iq2*_grid bytes come from {8,25,43}, iq3xxs_grid from {4,12,...,62}, iq3s_grid from
+// {1,3,...,15}), so the add is carry-free and this is bit-for-bit identical to
+// __vsub4(v ^ mask, mask) -- at three instructions instead of six, __vsub4 being
+// emulated as four LOP3 plus an IMAD.
+static __device__ __forceinline__ int apply_signs_nz(const uint32_t v, const uint32_t ones) {
+    return static_cast<int>((v ^ (ones * 0xff)) + ones);
+}
